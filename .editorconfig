root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 80

[*.{kt,kts,java,gradle}]
indent_size = 4

[*.{yaml,yml,json,xml,md}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[*.properties]
indent_size = 2

[{gradlew,gradlew.bat}]
# Generated wrapper scripts; leave them exactly as the tool writes them.
insert_final_newline = false
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
